---
import SocialShareReact from './SocialShare.jsx';

interface Props {
  url?: string;
  title: string;
  description?: string;
  hashtags?: string[];
  iconSize?: number;
  round?: boolean;
  className?: string;
  buttonClassName?: string;
  platforms?: ('facebook' | 'instagram')[];
  labels?: {
    facebook?: string;
    instagram?: string;
  };
  showLabels?: boolean;
}

const {
  url,
  title,
  description = '',
  hashtags = [],
  iconSize = 32,
  round = true,
  className = '',
  buttonClassName = '',
  platforms = ['facebook', 'instagram'],
  labels,
  showLabels = false
} = Astro.props;

// Ruta relativa: el cliente arma la URL con el host actual del navegador
const sharePath = url && /^https?:\/\//i.test(url)
  ? (() => {
      try {
        const parsed = new URL(url);
        return `${parsed.pathname}${parsed.search}`;
      } catch {
        return Astro.url.pathname + Astro.url.search;
      }
    })()
  : Astro.url.pathname + Astro.url.search;

const currentLang = Astro.url.pathname.split('/')[1] || 'es';

const defaultLabels = {
  es: {
    facebook: 'Facebook',
    instagram: 'Instagram',
  },
  en: {
    facebook: 'Facebook',
    instagram: 'Instagram',
  }
};

const finalLabels = labels || defaultLabels[currentLang as 'es' | 'en'];
---

<SocialShareReact
  client:load
  url={sharePath}
  title={title}
  description={description}
  hashtags={hashtags}
  iconSize={iconSize}
  round={round}
  className={className}
  buttonClassName={buttonClassName}
  platforms={platforms}
  labels={finalLabels}
  showLabels={showLabels}
/>
