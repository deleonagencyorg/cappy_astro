---
interface Product {
  id: string;
  slug: string;
  name: string;
  image: string;
  imageMobile?: string;
  background_image?: string;
  background_color?: string;
  text_color?: string;
}

export interface Props {
  products: Product[];
  className?: string;
  autoplay?: boolean;
  speed?: number;
  slidesPerView?: number;
  slidesPerViewMobile?: number;
  slidesPerViewTablet?: number;
  slidesPerViewDesktop?: number;
  spaceBetween?: number;
  spaceBetweenMobile?: number;
  spaceBetweenTablet?: number;
  spaceBetweenDesktop?: number;
  loop?: boolean;
  color?: string;
  cardBackgroundImage?: string;
  paddingTop?: string;
  mobilePaddingTop?: string;
}

const {
  products = [],
  className = '',
  autoplay = true,
  speed = 5000,
  slidesPerView = 4,
  slidesPerViewMobile = 4,
  slidesPerViewTablet = 3,
  slidesPerViewDesktop = slidesPerView,
  spaceBetween = 16,
  spaceBetweenMobile = 8,
  spaceBetweenTablet = 12,
  spaceBetweenDesktop = spaceBetween,
  loop = false,
  cardBackgroundImage = '',
  paddingTop = '120px',
  mobilePaddingTop = '4px'
} = Astro.props;

const DEFAULT_CARD_BACKGROUND_IMAGE = 'https://snack.yummiespromociones.com/SnacksyummiesAssets/bgcardcappy.webp';

const currentLang = Astro.url.pathname.split('/')[1] === 'es' ? 'es' : 'en';
const productsItems = Array.isArray(products) ? products : [];
const productsCount = productsItems.length;
const PLACEHOLDER_IMAGE_URL = 'https://snack.yummiespromociones.com/snacksyummies/placeholder.webp';

import LazyImage from '../LazyImage.astro';
---

<div
  class={`products-carousel ${className}`}
  data-autoplay={autoplay}
  data-speed={speed}
  data-slides-mobile={slidesPerViewMobile}
  data-slides-tablet={slidesPerViewTablet}
  data-slides-desktop={slidesPerViewDesktop}
  data-gap-mobile={spaceBetweenMobile}
  data-gap-tablet={spaceBetweenTablet}
  data-gap-desktop={spaceBetweenDesktop}
  data-loop={loop}
  style={{
    '--pc-padding-top': paddingTop,
    '--pc-padding-top-mobile': mobilePaddingTop,
  }}
>
  <div class="products-carousel__viewport" data-pc-viewport>
    <div class="products-carousel__track" data-pc-track>
      {productsCount === 0 ? (
        <article class="products-carousel__slide" data-pc-slide>
          <div class="product-card-cta">
            <div class="product-card">
              <div
                class="product-background"
                style={{
                  '--default-bg': `url(${cardBackgroundImage || DEFAULT_CARD_BACKGROUND_IMAGE})`,
                  '--hover-bg': `url(${cardBackgroundImage || DEFAULT_CARD_BACKGROUND_IMAGE})`,
                }}
              />
              <div class="product-image-container">
                <LazyImage
                  src={PLACEHOLDER_IMAGE_URL}
                  alt="Cappy"
                  class="product-image"
                  width={300}
                  height={400}
                />
              </div>
            </div>
            <p class="product-title">&nbsp;</p>
          </div>
        </article>
      ) : (
        productsItems.map((product) => (
          <article class="products-carousel__slide" data-pc-slide>
            <a
              href={`/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}/${product.slug}`}
              class="product-card-cta"
            >
              <div class="product-card">
                <div
                  class="product-background"
                  style={{
                    '--default-bg': `url(${cardBackgroundImage || DEFAULT_CARD_BACKGROUND_IMAGE})`,
                    '--hover-bg': `url(${product.background_image || cardBackgroundImage || DEFAULT_CARD_BACKGROUND_IMAGE})`,
                  }}
                />
                <div class="product-image-container">
                  <LazyImage
                    src={product.imageMobile || product.image}
                    alt={product.name}
                    class="product-image"
                    width={300}
                    height={400}
                  />
                </div>
              </div>
              <p class="product-title">{product.name}</p>
            </a>
          </article>
        ))
      )}
    </div>
  </div>

  {productsCount > 1 && (
    <div class="carousel-controls">
      <button class="carousel-btn carousel-btn-prev" type="button" aria-label="Anterior" data-pc-prev>
        <svg viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M13.5 14L8.5 9.5L13.5 5" stroke="#004AB2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="carousel-btn carousel-btn-next" type="button" aria-label="Siguiente" data-pc-next>
        <svg viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M7.5 14L12.5 9.5L7.5 5" stroke="#004AB2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  )}
</div>

<style>
  .products-carousel {
    width: 100%;
    padding: 1rem 0;
    padding-top: var(--pc-padding-top, 120px);
    overflow: hidden;
  }

  .products-carousel__viewport {
    width: 100%;
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
  }

  .products-carousel__track {
    display: flex;
    align-items: stretch;
    will-change: transform;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .products-carousel__track.is-centered {
    justify-content: center;
  }

  .products-carousel__slide {
    flex: 0 0 auto;
    min-width: 0;
    box-sizing: border-box;
  }

  .product-card-cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
    text-decoration: none;
  }

  .product-card {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-background {
    position: absolute;
    inset: 7%;
    border-radius: clamp(10px, 1.8vw, 24px);
    background-color: #f5d000;
    background-image: var(--default-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity 220ms ease;
  }

  .product-background::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: var(--hover-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 220ms ease;
  }

  @media (hover: hover) {
    .product-card-cta:hover .product-background::after,
    .product-card-cta:focus-visible .product-background::after {
      opacity: 1;
    }

    .product-card-cta:hover .product-card,
    .product-card-cta:focus-visible .product-card {
      animation: pcHoverBounce 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
  }

  @keyframes pcHoverBounce {
    0% { transform: translateY(0) scale(1); }
    55% { transform: translateY(-6px) scale(1.02); }
    100% { transform: translateY(0) scale(1); }
  }

  .product-image-container {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8%;
  }

  .product-image-container .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .product-title {
    font-size: clamp(0.75rem, 1.1vw, 0.95rem);
    font-weight: 600;
    color: #004ab2;
    text-align: center;
    width: 100%;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .carousel-controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .carousel-btn {
    width: 50px;
    height: 50px;
    background-color: transparent;
    border: 2px solid #004ab2;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    transition: background-color 200ms ease, opacity 200ms ease;
    flex-shrink: 0;
  }

  .carousel-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .carousel-btn:not(:disabled):hover {
    background-color: #004ab2;
  }

  .carousel-btn:not(:disabled):hover svg path {
    stroke: white;
  }

  .carousel-btn svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  @media (max-width: 767px) {
    .products-carousel {
      padding-top: var(--pc-padding-top-mobile, 20px);
    }

    .product-title {
      font-size: clamp(0.8125rem, 3.6vw, 0.95rem);
      line-height: 1.3;
      font-weight: 700;
      padding: 0 1px;
    }

    .product-card-cta {
      gap: 0.65rem;
    }

    .carousel-controls {
      justify-content: center;
    }

    .product-background {
      inset: 5%;
      border-radius: clamp(20px, 6vw, 30px);
      background-image: var(--hover-bg) !important;
    }

    .product-background::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .products-carousel__track {
      transition: none;
    }

    .product-background,
    .product-background::after {
      transition: none;
    }

    .product-card-cta:hover .product-card,
    .product-card-cta:focus-visible .product-card {
      animation: none;
    }
  }
</style>

<script>
  interface CarouselConfig {
    slidesMobile: number;
    slidesTablet: number;
    slidesDesktop: number;
    gapMobile: number;
    gapTablet: number;
    gapDesktop: number;
    autoplay: boolean;
    speed: number;
    loop: boolean;
  }

  function readInt(value: string | undefined, fallback: number): number {
    const parsed = parseInt(value || '', 10);
    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
  }

  function getBreakpointConfig(width: number, config: CarouselConfig) {
    if (width >= 1024) {
      return { visible: config.slidesDesktop, gap: config.gapDesktop };
    }
    if (width >= 768) {
      return { visible: config.slidesTablet, gap: config.gapTablet };
    }
    return { visible: config.slidesMobile, gap: config.gapMobile };
  }

  class ProductsCarouselEngine {
    private root: HTMLElement;
    private viewport: HTMLElement;
    private track: HTMLElement;
    private slides: HTMLElement[];
    private prevBtn: HTMLButtonElement | null;
    private nextBtn: HTMLButtonElement | null;
    private config: CarouselConfig;
    private index = 0;
    private autoplayTimer: ReturnType<typeof setInterval> | null = null;
    private resizeObserver: ResizeObserver | null = null;
    private touchStartX = 0;
    private touchDeltaX = 0;

    constructor(root: HTMLElement) {
      this.root = root;
      const viewport = root.querySelector('[data-pc-viewport]');
      const track = root.querySelector('[data-pc-track]');
      if (!(viewport instanceof HTMLElement) || !(track instanceof HTMLElement)) {
        throw new Error('Products carousel markup is incomplete');
      }

      this.viewport = viewport;
      this.track = track;
      this.slides = Array.from(track.querySelectorAll('[data-pc-slide]')).filter(
        (node): node is HTMLElement => node instanceof HTMLElement,
      );
      this.prevBtn = root.querySelector('[data-pc-prev]');
      this.nextBtn = root.querySelector('[data-pc-next]');

      const ds = root.dataset;
      this.config = {
        slidesMobile: readInt(ds.slidesMobile, 4),
        slidesTablet: readInt(ds.slidesTablet, 3),
        slidesDesktop: readInt(ds.slidesDesktop, 4),
        gapMobile: readInt(ds.gapMobile, 8),
        gapTablet: readInt(ds.gapTablet, 12),
        gapDesktop: readInt(ds.gapDesktop, 16),
        autoplay: ds.autoplay !== 'false',
        speed: readInt(ds.speed, 5000),
        loop: ds.loop === 'true',
      };

      this.bindEvents();
      this.render();
      this.startAutoplay();

      this.resizeObserver = new ResizeObserver(() => this.render());
      this.resizeObserver.observe(this.viewport);
    }

    private bindEvents(): void {
      this.prevBtn?.addEventListener('click', () => this.move(-1));
      this.nextBtn?.addEventListener('click', () => this.move(1));

      this.viewport.addEventListener('pointerdown', (event) => {
        if (!(event instanceof PointerEvent) || event.pointerType === 'mouse') return;
        this.touchStartX = event.clientX;
        this.touchDeltaX = 0;
      });

      this.viewport.addEventListener('pointermove', (event) => {
        if (!(event instanceof PointerEvent) || event.pointerType === 'mouse') return;
        this.touchDeltaX = event.clientX - this.touchStartX;
      });

      this.viewport.addEventListener('pointerup', () => {
        if (Math.abs(this.touchDeltaX) > 40) {
          this.move(this.touchDeltaX < 0 ? 1 : -1);
        }
        this.touchStartX = 0;
        this.touchDeltaX = 0;
      });

      window.addEventListener('resize', this.handleResize, { passive: true });
    }

    private handleResize = (): void => {
      this.render();
    };

    private getMetrics() {
      const { visible, gap } = getBreakpointConfig(window.innerWidth, this.config);
      const viewportWidth = this.viewport.clientWidth;
      const slideWidth = visible > 0
        ? (viewportWidth - gap * (visible - 1)) / visible
        : viewportWidth;
      const maxIndex = Math.max(0, this.slides.length - visible);

      return { visible, gap, viewportWidth, slideWidth, maxIndex };
    }

    private render(): void {
      if (this.slides.length === 0) return;

      const { visible, gap, slideWidth, maxIndex } = this.getMetrics();
      const shouldCenter = this.slides.length <= visible;

      this.index = Math.min(this.index, maxIndex);

      this.track.style.gap = `${gap}px`;
      this.slides.forEach((slide) => {
        slide.style.width = `${slideWidth}px`;
        slide.style.flexBasis = `${slideWidth}px`;
      });

      if (shouldCenter) {
        this.track.classList.add('is-centered');
        this.track.style.transform = 'translateX(0)';
      } else {
        this.track.classList.remove('is-centered');
        const offset = this.index * (slideWidth + gap);
        this.track.style.transform = `translateX(-${offset}px)`;
      }

      if (this.prevBtn) {
        this.prevBtn.disabled = shouldCenter || (!this.config.loop && this.index <= 0);
      }
      if (this.nextBtn) {
        this.nextBtn.disabled = shouldCenter || (!this.config.loop && this.index >= maxIndex);
      }
    }

    private move(direction: number): void {
      const { maxIndex } = this.getMetrics();
      if (maxIndex === 0) return;

      if (this.config.loop) {
        if (direction > 0) {
          this.index = this.index >= maxIndex ? 0 : this.index + 1;
        } else {
          this.index = this.index <= 0 ? maxIndex : this.index - 1;
        }
      } else if (direction > 0) {
        this.index = Math.min(this.index + 1, maxIndex);
      } else {
        this.index = Math.max(this.index - 1, 0);
      }

      this.render();
      this.restartAutoplay();
    }

    private startAutoplay(): void {
      this.stopAutoplay();
      if (!this.config.autoplay || this.slides.length <= 1) return;

      this.autoplayTimer = setInterval(() => {
        const { maxIndex } = this.getMetrics();
        if (maxIndex === 0) return;
        this.move(1);
      }, this.config.speed);
    }

    private restartAutoplay(): void {
      this.startAutoplay();
    }

    private stopAutoplay(): void {
      if (this.autoplayTimer) {
        clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }
    }

    public destroy(): void {
      this.stopAutoplay();
      this.resizeObserver?.disconnect();
      window.removeEventListener('resize', this.handleResize);
    }
  }

  let carouselInstances: ProductsCarouselEngine[] = [];

  function cleanupCarousels(): void {
    carouselInstances.forEach((instance) => instance.destroy());
    carouselInstances = [];
  }

  function initializeCarousels(): void {
    cleanupCarousels();
    document.querySelectorAll('.products-carousel').forEach((element) => {
      if (element instanceof HTMLElement) {
        carouselInstances.push(new ProductsCarouselEngine(element));
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initializeCarousels);
  document.addEventListener('astro:page-load', initializeCarousels);
  document.addEventListener('astro:after-swap', initializeCarousels);
  document.addEventListener('astro:before-swap', cleanupCarousels);
</script>
