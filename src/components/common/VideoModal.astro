---
interface Props {
  id?: string;
  videoUrl?: string;
  title?: string;
}

const {
  id = 'videoModal',
  videoUrl = '',
  title = ''
} = Astro.props;

// Extraer el ID del video de YouTube de diferentes formatos de URL
function getYouTubeVideoId(url: unknown): string {
  if (!url || typeof url !== 'string') return '';
  
  // Formatos soportados:
  // - https://www.youtube.com/watch?v=VIDEO_ID
  // - https://youtu.be/VIDEO_ID
  // - https://www.youtube.com/embed/VIDEO_ID
  const patterns = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\s?]+)/,
    /youtube\.com\/watch\?.*v=([^&\s?]+)/
  ];
  
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match && match[1]) {
      return match[1];
    }
  }
  
  // Si no coincide con patrones, asumir que es el ID directamente
  return url;
}

const videoId = getYouTubeVideoId(videoUrl);
const embedUrl = videoId ? `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0` : '';
---

<div id={id} class="fixed inset-0 flex items-center justify-center z-[100] hidden">
  <div class="modal-backdrop fixed inset-0 bg-black/80" data-modal-backdrop></div>
  
  <div class="relative z-10 w-full max-w-5xl mx-4 transform transition-all">
    <!-- Botón cerrar -->
    <button 
      type="button" 
      class="modal-close absolute -top-12 right-0 text-white hover:opacity-80 transition-opacity" 
      aria-label="Cerrar"
    >
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <!-- Contenedor del video responsive -->
    <div class="relative w-full" style="padding-bottom: 56.25%;">
      <iframe
        id={`${id}-iframe`}
        class="absolute inset-0 w-full h-full rounded-lg shadow-2xl"
        src=""
        title={title}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>

<script define:vars={{ modalId: id, embedUrl: embedUrl }}>
  function initVideoModal(modalId, embedUrl) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    
    const closes = modal.querySelectorAll('.modal-close');
    const backdrop = modal.querySelector('[data-modal-backdrop]');
    const iframe = document.getElementById(`${modalId}-iframe`);
    
    function closeModal() {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      // Limpiar el src para detener el video
      if (iframe) {
        iframe.src = '';
      }
    }
    
    function openModal() {
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      // Cargar el video cuando se abre
      if (iframe && embedUrl) {
        iframe.src = embedUrl;
      }
    }
    
    // Event listeners para cerrar
    closes.forEach(btn => btn.addEventListener('click', closeModal));
    if (backdrop) backdrop.addEventListener('click', closeModal);
    
    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
    
    // Exponer función global para abrir el modal
    if (typeof window !== 'undefined') {
      if (!window.videoModals) window.videoModals = {};
      window.videoModals[modalId] = { open: openModal, close: closeModal };
    }
  }
  
  // Inicializar
  document.addEventListener('DOMContentLoaded', () => {
    initVideoModal(modalId, embedUrl);
  });
  document.addEventListener('astro:page-load', () => {
    initVideoModal(modalId, embedUrl);
  });
</script>

<style>
  /* Asegurar que el modal esté por encima de todo */
  #videoModal,
  [id^="videoModal-"] {
    z-index: 9999;
  }
</style>
