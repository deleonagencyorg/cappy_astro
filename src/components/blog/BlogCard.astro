---
import LazyImage from '../common/LazyImage.astro';
import { getLocale } from '../../i18n/i18n';
import { Image } from 'astro:assets';
import { fade } from 'astro:transitions';

interface Props {
  image?: string;
  title: string;
  id: string;
  slug: string;
  preview?: string;
  textColor?: string;
  iconColor?: string;
  hoverImage?: string;
  currentLang?: string;
  published_date?: string;
}

const { 
  image, 
  title, 
  id,
  slug,
  preview,
  textColor = 'text-blue-900',
  iconColor = 'text-blue-900',
  hoverImage = image || preview,
  currentLang = getLocale(),
  published_date
} = Astro.props;

const imageSrc = image || preview || 'https://snack.yummiespromociones.com/SnacksyummiesAssets/cappy_Banner-diversion.webp';

const blogLink = `/${currentLang}/blog/${slug || id}`;
const viewBlogText = currentLang === 'es' ? 'Leer más' : 'Read more';
---

<div class="news-card">
  <a href={blogLink} class="block group relative overflow-hidden rounded-[1rem]" style="aspect-ratio: 9/16;">
    <img 
      src={imageSrc}
      alt={title} 
      class="absolute inset-0 w-full h-full object-cover transform transition-transform duration-500 ease-out group-hover:scale-105" 
      loading="lazy" 
      transition:name={`blog-image-${id}`}
    />
    <!-- Overlay inferior azul oscuro para título y botón -->
    <div class="blog-card__overlay absolute inset-x-0 bottom-0 z-[1] pointer-events-none"></div>
    <!-- Contenido inferior -->
    <div class="absolute inset-x-0 bottom-0 p-3 z-10 flex flex-col gap-2">
      <h3 class="text-white font-bold text-sm md:text-base leading-tight">{title}</h3>
      <div>
        <span class="inline-block border-2 border-white bg-transparent text-white py-1.5 px-4 rounded-md text-center text-xs md:text-sm font-medium">
          {viewBlogText}
        </span>
      </div>
    </div>
  </a>
</div>

<style is:global>
  .news-card .blog-card__overlay {
    height: 52%;
    background: linear-gradient(
      to top,
      rgba(0, 54, 160, 0.96) 0%,
      rgba(0, 54, 160, 0.9) 38%,
      rgba(0, 54, 160, 0.72) 68%,
      rgba(0, 54, 160, 0) 100%
    );
    transition: background 0.3s ease;
  }

  .news-card .group:hover .blog-card__overlay {
    background: linear-gradient(
      to top,
      rgba(0, 54, 160, 0.98) 0%,
      rgba(0, 54, 160, 0.94) 42%,
      rgba(0, 54, 160, 0.78) 72%,
      rgba(0, 54, 160, 0.1) 100%
    );
  }
</style>
