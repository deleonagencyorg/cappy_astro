---
export interface Props {
  videoUrl?: string;
  mobileVideoUrl?: string;
  posterUrl?: string;
}

const { 
  videoUrl = "https://snack.yummiespromociones.com/SnacksyummiesAssets/CAPPY_VIDEOLOOP-NUEVO.mp4",
  mobileVideoUrl = "https://snack.yummiespromociones.com/SnacksyummiesAssets/Bodegon_800x1200.mp4",
  posterUrl = "https://snack.yummiespromociones.com/SnacksyummiesAssets/bgvideocappy.png"
} = Astro.props;
---

<section class="w-full relative overflow-hidden bg-black">
  <div class="w-full">
    <video 
      id="fullwidth-video"
      class="w-full h-auto object-cover"
      muted
      loop
      playsinline
      autoplay
      preload="metadata"
      poster={posterUrl}
      data-desktop-video={videoUrl}
      data-mobile-video={mobileVideoUrl}
    >
      <source src={videoUrl} type="video/mp4">
      Tu navegador no soporta el elemento de video.
    </video>
  </div>
</section>

<script>
  function setupVideoSource() {
    const video = document.getElementById('fullwidth-video') as HTMLVideoElement | null;
    if (!video) return;

    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const targetUrl = isMobile ? video.dataset.mobileVideo : video.dataset.desktopVideo;

    if (!targetUrl || video.currentSrc === targetUrl) return;

    video.src = targetUrl;
    video.load();
  }

  function initVideoAutoplay() {
    const video = document.getElementById('fullwidth-video') as HTMLVideoElement | null;
    if (!video) return;

    setupVideoSource();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          video.play().catch((error: unknown) => {
            console.log('Autoplay prevented:', error);
          });
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.5 });

    observer.observe(video);
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setupVideoSource();
        initVideoAutoplay();
      });
    } else {
      setupVideoSource();
      initVideoAutoplay();
    }

    const mediaQuery = window.matchMedia('(max-width: 767px)');
    const handleMediaChange = () => {
      setupVideoSource();
    };

    if (typeof mediaQuery.addEventListener === 'function') {
      mediaQuery.addEventListener('change', handleMediaChange);
    } else if (typeof mediaQuery.addListener === 'function') {
      mediaQuery.addListener(handleMediaChange);
    }
  }

  document.addEventListener('astro:page-load', () => {
    setupVideoSource();
    initVideoAutoplay();
  });
</script>

<style>
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }
  
  @media (max-width: 767px) {
    video {
      width: 100%;
      height: auto;
    }
  }
</style>
