---
import LazyImage from '../common/LazyImage.astro';

interface ProductItem {
  src: string;
  alt?: string;
  className?: string;
  style?: string;
}

interface CampaignBannerData {
  backgroundDesktop?: string;
  backgroundMobile?: string;
  textTop?: string;
  textMiddle?: string;
  textBottom?: string;
  ctaText?: string;
  ctaUrl?: string;
  products?: ProductItem[];
}

interface Props {
  data?: CampaignBannerData;
}

const { data } = Astro.props as Props;

const backgroundDesktop = data?.backgroundDesktop || 'https://snack.yummiespromociones.com/SnacksyummiesAssets/CAPPY_FONDO-BANNER_DESKTOP.webp';
const backgroundMobile = data?.backgroundMobile || 'https://snack.yummiespromociones.com/SnacksyummiesAssets/CAPPY_FONDO-BANNER_MOBILE.webp';
const textTop = data?.textTop || 'Si necesitas';
const textMiddle = data?.textMiddle || 'diversión';
const textBottom = data?.textBottom || 'es';
const ctaText = data?.ctaText || 'Descubre el universo Cappy';
const ctaUrl = data?.ctaUrl || '/es';
const products = data?.products || [
  {
    src: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/CAPPY_QUESO.webp',
    alt: 'Cappy Queso',
    className: 'pack-one',
    style: '--rotation: -18deg; --x: 6%; --y: 10%; --delay: 0s;'
  },
  {
    src: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/CAPPY_QUESO-MANTEQUILLA.webp',
    alt: 'Cappy Queso Mantequilla',
    className: 'pack-two',
    style: '--rotation: 18deg; --x: 68%; --y: 12%; --delay: 0.35s;'
  },
  {
    src: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/CAPPY_PICOSITOS.webp',
    alt: 'Cappy Picitos',
    className: 'pack-three',
    style: '--rotation: -10deg; --x: 15%; --y: 70%; --delay: 0.7s;'
  },
  {
    src: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/CAPPY_CHILE-TOREADO.webp',
    alt: 'Cappy Chile Toreado',
    className: 'pack-four',
    style: '--rotation: 14deg; --x: 72%; --y: 68%; --delay: 1.05s;'
  }
];
---

<div class="cappy-campaign-banner">
  <div class="cappy-campaign-bg" aria-hidden="true">
    <LazyImage
      src={backgroundDesktop}
      alt="Cappy banner fondo desktop"
      class="cappy-campaign-bg-desktop"
      loading="eager"
      priority={true}
    />
    <LazyImage
      src={backgroundMobile}
      alt="Cappy banner fondo mobile"
      class="cappy-campaign-bg-mobile"
      loading="eager"
      priority={true}
    />
  </div>

  <div class="cappy-campaign-visual" aria-label="Cappy universo banner">
    {products.map((product, index) => (
      <div
        class={`cappy-pack ${product.className || ''}`.trim()}
        style={product.style || `--rotation: ${index % 2 === 0 ? '-12deg' : '12deg'}; --x: ${index === 0 ? '6%' : index === 1 ? '68%' : index === 2 ? '11%' : '72%'}; --y: ${index === 0 ? '10%' : index === 1 ? '12%' : index === 2 ? '70%' : '70%'}; --delay: ${index * 0.35}s;`}
      >
        <LazyImage
          src={product.src}
          alt={product.alt || `Cappy producto ${index + 1}`}
          class="cappy-pack-image"
          loading="eager"
          priority={index === 0}
        />
      </div>
    ))}
  </div>

  <div class="cappy-campaign-content">
    <div class="cappy-copy">
      <div class="cappy-copy-top">{textTop}</div>
      <div class="cappy-copy-middle">{textMiddle}</div>
      <div class="cappy-copy-bottom">{textBottom}</div>
    </div>

    <a href={ctaUrl} class="cappy-cta">{ctaText}</a>
  </div>
</div>

<style>
  .cappy-campaign-banner {
    position: relative;
    width: 100%;
    min-height: clamp(520px, 62vw, 980px);
    overflow: hidden;
    background: #f3cc17;
    isolation: isolate;
  }

  .cappy-campaign-banner::before {
    content: "";
    position: absolute;
    inset: -3% -8% -4% -8%;
    background: linear-gradient(135deg, rgba(255, 92, 61, 0.9) 0%, rgba(255, 92, 61, 0.9) 100%);
    clip-path: polygon(0 18%, 20% 0, 31% 18%, 55% 0, 74% 13%, 100% 0, 100% 36%, 84% 50%, 100% 61%, 100% 100%, 0 100%, 0 68%, 19% 49%, 0 34%);
    z-index: 0;
    opacity: 0.92;
  }

  .cappy-campaign-banner::after {
    content: "";
    position: absolute;
    inset: 22% 22% 16% 22%;
    background: #0d4fb0;
    clip-path: polygon(50% 0%, 61% 33%, 100% 50%, 61% 67%, 50% 100%, 39% 67%, 0% 50%, 39% 33%);
    border-radius: 10% 10% 14% 14%;
    z-index: 1;
    box-shadow: inset 0 0 0 18px rgba(255,255,255,0.06);
  }

  .cappy-campaign-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cappy-campaign-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .cappy-campaign-bg-desktop {
    display: none;
  }

  .cappy-campaign-bg-mobile {
    display: block;
  }

  .cappy-campaign-visual {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .cappy-pack {
    position: absolute;
    left: var(--x, 50%);
    top: var(--y, 50%);
    width: clamp(120px, 17vw, 260px);
    transform: rotate(var(--rotation, 0deg));
    animation: cappyPackFloat 3.2s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.14));
    will-change: transform;
  }

  .cappy-pack-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    pointer-events: none;
  }

  .pack-one {
    left: 8%;
    top: 10%;
    --rotation: -18deg;
  }

  .pack-two {
    left: 72%;
    top: 15%;
    --rotation: 18deg;
  }

  .pack-three {
    left: 18%;
    top: 68%;
    --rotation: -10deg;
  }

  .pack-four {
    left: 70%;
    top: 68%;
    --rotation: 12deg;
  }

  .cappy-campaign-content {
    position: relative;
    z-index: 4;
    min-height: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1rem 2rem;
  }

  .cappy-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    margin-bottom: 1rem;
    transform: translateY(-18px);
  }

  .cappy-copy-top,
  .cappy-copy-bottom {
    font-size: clamp(2.2rem, 3.1vw, 5rem);
    font-weight: 900;
    line-height: 0.9;
    color: #fff;
    letter-spacing: -0.07em;
    text-transform: none;
    text-shadow: 0 4px 0 rgba(0,0,0,0.06);
  }

  .cappy-copy-middle {
    font-size: clamp(4.5rem, 9vw, 12rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.08em;
    color: #0d3d8d;
    text-transform: none;
    margin: 0.08em 0 0.12em;
    text-shadow: 0 10px 0 rgba(255,255,255,0.08);
  }

  .cappy-cta {
    position: relative;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(13, 60, 135, 0.92);
    color: #fff;
    border-radius: 18px;
    padding: 1rem 1.5rem;
    font-weight: 900;
    font-size: clamp(1.3rem, 2vw, 2.6rem);
    line-height: 1;
    box-shadow: 0 18px 28px rgba(13,60,135,0.18);
    text-decoration: none;
    max-width: min(86%, 620px);
    margin-top: 0.25rem;
  }

  @keyframes cappyPackFloat {
    0%,
    100% {
      transform: translateY(0px) rotate(var(--rotation, 0deg));
    }
    50% {
      transform: translateY(-18px) rotate(var(--rotation, 0deg));
    }
  }

  @media (min-width: 768px) {
    .cappy-campaign-banner {
      min-height: clamp(680px, 40vw, 900px);
    }

    .cappy-campaign-bg-desktop {
      display: block;
    }

    .cappy-campaign-bg-mobile {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .cappy-campaign-banner {
      min-height: 550px;
    }

    .cappy-campaign-banner::after {
      inset: 24% 12% 18% 12%;
    }

    .cappy-campaign-content {
      padding-top: 2rem;
    }

    .cappy-copy {
      transform: translateY(-10px);
    }

    .cappy-copy-top,
    .cappy-copy-bottom {
      font-size: clamp(1.7rem, 8vw, 3.4rem);
    }

    .cappy-copy-middle {
      font-size: clamp(3.5rem, 17vw, 7.5rem);
    }

    .cappy-pack {
      width: clamp(96px, 29vw, 170px);
    }

    .cappy-cta {
      border-radius: 16px;
      padding: 0.8rem 1rem;
      margin-top: 0.25rem;
      font-size: clamp(1rem, 5vw, 1.8rem);
    }
  }
</style>
