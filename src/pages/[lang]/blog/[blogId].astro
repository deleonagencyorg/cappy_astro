---
import { resolveStaticPath } from '../../../utils/staticPaths';
import BlogDetail from '../../../views/Blog/Detail/index.astro';
import { setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCmsNews, mediaUrl } from '../../../services/api/content';

export async function getStaticPaths() {
  const locales = ['en', 'es'];
  const paths: any[] = [];
  for (const locale of locales) {
    const news = (await getCmsNews(locale)) ?? [];
    {
      const posts = news.map((item) => ({
        id: item.id,
        slug: item.slug || item.id,
        title: item.title,
        summary: item.excerpt || item.subtitle || '',
        preview: item.image || '',
        image: mediaUrl(item.image),
        content: item.content || '',
        author: item.author || '',
        published_date: item.publishedAt || item.createdAt || '',
        tags: item.tags || [],
        videos: [],
        gallery: item.gallery || [],
      }));
      for (const blogPost of posts) {
        paths.push({
          params: { lang: locale, blogId: blogPost.slug },
          props: { blogPost, currentLang: locale as Locale, allBlogPosts: posts },
        });
      }
    }
  }
  return paths;
}

const staticPath = await resolveStaticPath(getStaticPaths, Astro.params);
if (!staticPath) {
  return Astro.rewrite('/es/404');
}

const { blogPost, currentLang, allBlogPosts } = staticPath.props;
const { lang, blogId } = Astro.params;

// Set locale for this page
setLocale(lang as Locale);
---
<MainLayout title={blogPost.title}>
  <BlogDetail blogPost={blogPost} currentLang={currentLang} allBlogPosts={allBlogPosts} />
</MainLayout>
